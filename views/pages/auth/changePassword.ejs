<!-- including header -->
<%- include('../../partials/header.ejs') %>

<!-- main content -->
<section class="my-5">
	<div class="container">
		<div class="row">
			<div class="col-md-2">
				<!-- including side navigation bar -->
				<%- include('../../partials/sideNavBar.ejs') %>
			</div>

			<!-- change password contents -->
			<div class="col-md-10 card card-body p-5">
				<h1 class="text-center mb-4">Change Password</h1>

                <!-- change password form -->
                <div class="col-md-10 mx-auto my-3 p-5 card card-body shadow">
                    <form action="/auth/changePassword" method="post">
                        <div class="form-group my-3">
                            <label for="oldPassword">Old Password</label>
                            <input class="form-control" type="password" name="oldPassword" id="oldPassword">
                        </div>
                        <div class="form-group my-3">
                            <label for="newPassword">New Password</label>
                            <input class="form-control" type="password" name="newPassword" id="newPassword">
                        </div>
                        <div class="form-group my-3">
                            <label for="confirmPassword">Confirm Password</label>
                            <input class="form-control" type="password" name="confirmPassword" id="confirmPassword">
                        </div>
                        <input class="btn btn-primary my-3" type="submit" value="Update Password">
                    </form>
                </div>
			</div>
		</div>
	</div>
</section>

<!-- including footer -->
<%- include('../../partials/footer.ejs') %>

</body>

</html>