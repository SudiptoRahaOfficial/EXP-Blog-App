<!-- including header -->
<%- include('../../partials/header.ejs') %>

<!-- main content -->
<section class="my-5" id="createProfile">
	<div class="container">
		<div class="row">
			<div class="col-md-2">
				<!-- including side navigation bar -->
				<%- include('../../partials/sideNavBar.ejs') %>
			</div>

			<div class="col-md-10">
				<div class="row">
					<div class="card shadow p-2">

						<h4 class="text-center my-5">List of all comments</h4>

						<div class="mt-5" id="comment-holder">
							<% if (comments.length === 0) { %>
							    <p class="text-center text-muted">This post has no comments yet</p>
							<% } else { %>
                                <% for (let comment of comments.reverse()) { %>
                                    <div class="d-flex border p-2 mb-2">
                                        <img src="<%= comment.user.profilePic %>" class="rounded-circle flex-shrink-0 me-3" alt="commenter" style="width: 30px; height: 30px; object-fit: cover; object-position: center;">

                                        <div class="my-3">
                                            <p class="text-muted">
                                                                    on post <strong><%= comment.post.title%></strong> by <strong><a href="/author/<%= comment.user._id %>"><%= comment.user.username %></a></strong>, <%= moment(comment.createdAt) %>
                                                                </p>
                                            <p><%= comment.body %></p>
                                            <div name="replies">
                                                <% if (comment.replies.length > 0) { %>
                                                    <% for (let reply of comment.replies) { %>
                                                        <div class="d-flex">
                                                            <img src="<%= reply.user.profilePic %>" class="rounded-circle flex-shrink-0 me-3" alt="replier" style="width: 25px; height: 25px; object-fit: cover; object-position: center;">

                                                            <div>
                                                                <p><%= reply.body %></p>
                                                            </div>
                                                        </div>
                                                    <% } %>
                                                <% } %>
                                            </div>
                                            <div class="my-3" id="newReply">
                                                <input type="text" class="form-control" placeholder="press enter to reply" name="reply" data-comment="<%= comment._id %>">
                                            </div>
                                        </div>
                                    </div>
                                <% } %>
							<% } %>
						</div>

					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- including footer -->
<%- include('../../partials/footer.ejs') %>

<!-- linking comments script -->
<script src="/scripts/comment.js"></script>

</body>

</html>