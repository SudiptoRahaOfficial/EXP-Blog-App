<!-- including header -->
<%- include('../../partials/header.ejs') %>

<!-- main content -->
<section class="my-5" id="createProfile">
	<div class="container">

		<div class="col-md-4">
			<h2>left container</h2>
		</div>

		<div class="col-md-8">
			<div class="row">
				<div class="card shadow p-5">

					<h4 class="text-center mb-5"> <%= title %> </h4>

					<div class="profile-pic text-center">
						<!-- profile pic -->
						<img 
							src="<%= user.profilePic %>" 
							width="200"
							alt="profile-pic" 
							class="img-fluid img-thumbnail" 
							id="profilePic"
						/>

						<form 
							action="/uploads/profilePic" 
							class="my-2" 
							id="profilePicFrom"
						>
							<!-- input field for file upload -->
							<input 
								type="file" 
								accept="image/*" 
								name="profilePic" 
								id="profilePicFile"
							/>
							<!-- button for remove profile pic -->
							<input 
							type="button" 
							value="Remove" 
							class="btn btn-danger btn-sm my-2" id="removeProfilePic"
							style="display: <%= user.profilePic.includes('default-profile-avater.png') ? 'none' : 'block' %>"
							/>
						</form>
					</div>

					<div style="padding: 50px 100px;">
						<form action="/dashboard/create-profile" method="post">
							<!-- field for name -->
							<div class="form-group">
								<label for="name">Enter your name</label>
								<input 
									type="text"
									name="name"
									placeholder="Enter your name"
									class="form-control"
									id="name"
								/>
							</div>
							<!-- field for email -->
							<div class="form-group">
								<label for="email">Enter your email</label>
								<input 
									type="email"
									name="email"
									placeholder="Enter your email"
									class="form-control"
									id="email"
									value="<%= user.email %>"
									disabled
								/>
							</div>
							<!-- field for title -->
							<div class="form-group">
								<label for="title">Enter a short title</label>
								<input 
									type="text"
									name="title"
									placeholder="Enter a short title"
									class="form-control"
									id="title"
								/>
							</div>
							<!-- field for bio -->
							<div class="form-group">
								<label for="bio">Enter a short bio</label>
								<textarea
									name="bio"
									placeholder="Enter a short bio"
									class="form-control"
									id="bio"
								></textarea>
							</div>
							<!-- fields for social links -->
							<div>
								<p class="lead">Your social links</p>
								<!-- field for facebook -->
								<div class="input-group mb-3">
									<div class="input-group-prepend">
										<img 
											src="/images/icons/facebook.png" alt="facebook-icon"
											width="25"
										>
									</div>
									<input
										class="form-control"
										type="text"
										name="facebook"
										placeholder="Facebook link"
									/>
								</div>
								<!-- field for twitter -->
								<div class="input-group mb-3">
									<div class="input-group-prepend">
										<img 
											src="/images/icons/twitter.png" alt="twitter"
											width="25"
										>
									</div>
									<input
										class="form-control"
										type="text"
										name="twitter"
										placeholder="Twitter link"
									/>
								</div>
								<!-- field for linkedin -->
								<div class="input-group mb-3">
									<div class="input-group-prepend">
										<img 
											src="/images/icons/linkedin.png" alt="linkedin"
											width="25"
										>
									</div>
									<input
										class="form-control"
										type="text"
										name="linkedin"
										placeholder="Linkedin link"
									/>
								</div>
								<!-- field for github -->
								<div class="input-group mb-3">
									<div class="input-group-prepend">
										<img 
											src="/images/icons/github.png" alt="github"
											width="25"
										>
									</div>
									<input
										class="form-control"
										type="text"
										name="github"
										placeholder="GitHub link"
									/>
								</div>
								<!-- field for website -->
								<div class="input-group mb-3">
									<div class="input-group-prepend">
										<img 
											src="/images/icons/website.png" alt="website-icon"
											width="25"
										>
									</div>
									<input
										class="form-control"
										type="text"
										name="website"
										placeholder="Website link"
									/>
								</div>
							</div>
						</form>
					</div>

				</div>
			</div>
		</div>

	</div>
</section>

<!-- including footer -->
<%- include('../../partials/footer.ejs') %>

</body>

</html>