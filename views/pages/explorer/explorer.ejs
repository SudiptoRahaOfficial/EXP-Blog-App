<!-- including header -->
<%- include('../../partials/header.ejs') %>

<!-- main content -->
<section class="my-5">
	<div class="container">
		<div class="row">
			<div class="col-md-6 offset-md-3">

				<!-- filter tabs -->
				<section class="mb-5">
					<!-- latest -->
					<a href="/explorer?filter=latest" class="btn <%= filter === 'latest' ? 'btn-primary' : 'btn-secondary' %>">Latest</a>
					<!-- week -->
					<a href="/explorer?filter=week" class="btn <%= filter === 'week' ? 'btn-primary' : 'btn-secondary' %>">Week</a>
					<!-- month -->
					<a href="/explorer?filter=month" class="btn <%= filter === 'month' ? 'btn-primary' : 'btn-secondary' %>">Month</a>
					<!-- all -->
					<a href="/explorer?filter=all" class="btn <%= filter === 'all' ? 'btn-primary' : 'btn-secondary' %>">All</a>
				</section>

				<!-- post exploeres -->
				<section>
					<% if (posts.length === 0) { %>
					<p class="text-center text-muted">
						There is nothing to show
					</p>
					<% } else { %>
					<% for (let post of posts) { %>
					<div class="card card-body mb-3">
						<% if (post.thumbnail) { %>
						<img src="<%= post.thumbnail %>" alt="<%= post.title %>" class="img-fluid mb-2">
						<% } %>
						<a href="/explorer/<%= post._id %>" style="color: #222;">
							<h5><%= post.title %></h5>
							<p class="mb-4">
								<%= truncate(post.body) %>
							</p>
						</a>
						<div class="d-flex">
							<small>
								<%= moment(post.createdAt) %>,
								posted by <b><%= post.author.username %></b>,
								<%= post.readTime %>
							</small>
							<% if (user) { %>
								<span class="ms-auto bookmark" data-post="<%= post._id %>">
									<% if (bookmarks.includes(post._id)) { %>
										<img src="/images/icons/bookmarked.png" alt="bookmarked" width="20">
									<% } else { %>
										<img src="/images/icons/bookmark.png" alt="bookmark" width="20">
									<% } %>
								</span>
							<% } %>
						</div>
					</div>
					<% } %>
					<% } %>
				</section>

				<!-- pagination -->
				<% if (totalPage > 1) { %>
				<nav aria-label="Page navigation example text-center">
					<ul class="pagination">
						<!-- previous btn -->
						<li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
							<a class="page-link" href="<%= `/explorer?filter=${filter}&page=${currentPage-1}` %>" aria-label="Previous">
								<span aria-hidden="true">&laquo;</span>
							</a>
						</li>

						<!-- page numbers -->
						<% for (let i = 1; i <= totalPage; i++) { %>
							<li class="page-item <%= currentPage === i ? 'active' : '' %>">
								<a class="page-link" href="<%= `/explorer?filter=${filter}&page=${i}` %>" aria-label="Previous">
									<%= i %>
								</a>
							</li>
						<% } %>

						<!-- next btn -->
						<li class="page-item <%= currentPage === totalPage ? 'disabled' : '' %>">
							<a class="page-link" href="<%= `/explorer?filter=${filter}&page=${currentPage+1}` %>" aria-label="Next">
								<span aria-hidden="true">&raquo;</span>
							</a>
						</li>
					</ul>
				</nav>
				<% } %>

			</div>
		</div>
	</div>
</section>

<!-- including footer -->
<%- include('../../partials/footer.ejs') %>

<!-- linking bookmark script -->
<script src="/scripts/bookmarks.js"></script>

</body>

</html>