<!-- including header -->
<%- include('../../partials/header.ejs') %>

<!-- main content -->
<section class="my-5">
	<div class="container">
		<div class="row">
			<div class="col-md-6 offset-md-3">

				<div class="card card-body">
					<div>
						<h3><%= post.title %></h3>

						<div class="d-flex">
							<small>
								<%= moment(post.createdAt) %>,
								posted by <b><%= post.author.username %></b>,
								<%= post.readTime %>
							</small>
							<% if (user) { %>
							<span class="ms-auto bookmark" data-post="<%= post._id %>">
								<% if (bookmarks.includes(post._id)) { %>
								<img src="/images/icons/bookmarked.png" alt="bookmarked" width="20">
								<% } else { %>
								<img src="/images/icons/bookmark.png" alt="bookmark" width="20">
								<% } %>
							</span>
							<% } %>
						</div>

						<% if (post.thumbnail) { %>
						<img src="<%= post.thumbnail %>" alt="post thumbnail image" class="img-fluid my-2">
						<% } %>
					</div>
					<div>
						<%= truncate(post.body) %>
					</div>
					<div class="my-4">
						<% if (!user) { %>
						<button class="btn btn-success btn-sm" disabled>
							like - <%= post.likes.length %>
						</button>
						<button class="btn btn-danger btn-sm" disabled>
							dislike - <%= post.dislikes.length %>
						</button>
						<p class="text-center text-muted mt-4">
							<a href="/auth/signin">signin</a> to get full access.
						</p>
						<% } else { %>
						<button class="btn btn-success btn-sm" id="likeBtn" data-post="<%= post._id %>">
							<%= post.likes.includes(user._id) ? 'liked' : 'like' %> - <%= post.likes.length %>
						</button>
						<button class="btn btn-danger btn-sm" id="dislikeBtn" data-post="<%= post._id %>">
							<%= post.dislikes.includes(user._id) ? 'disliked' : 'dislike' %> - <%= post.dislikes.length %>
						</button>
						<div class="mt-3">
							<label for="comment">
								leave a comment
							</label>
							<input type="text" name="comment" id="comment" class="form-control" placeholder="press enter to submit you comment" data-post="<%= post._id %>">
						</div>
						<div class="mt-5" id="comment-holder">
							<% if (post.comments.length === 0) { %>
							<p class="text-center text-muted">This post has no comments yet</p>
							<% } else { %>
                                <% for (let comment of post.comments.reverse()) { %>
                                    <div class="d-flex border">
                                        <img src="<%= comment.user.profilePic %>" class="flex-shrink-0 me-3" alt="user-of-comment" style="width: 30px;">

                                        <div class="my-3">
                                            <p><%= comment.body %></p>
                                            <div name="replies">
                                                <% if (comment.replies.length > 0) { %>
                                                    <% for (let reply of comment.replies) { %>
                                                        <div class="d-flex">
                                                            <img src="<%= reply.user.profilePic %>" class="flex-shrink-0 me-3" alt="user-of-reply" style="width: 20px;">
  
                                                            <div>
                                                                <p><%= reply.body %></p>
                                                            </div>
                                                        </div>
                                                    <% } %>
                                                <% } %>
                                            </div>
                                            <div class="my-3" id="newReply">
                                                <input type="text" class="form-control" placeholder="press enter to reply" name="reply" data-comment="<%= comment._id %>">
                                            </div>
                                        </div>
                                    </div>
                                <% } %>
							<% } %>
						</div>
						<% } %>
					</div>
				</div>

			</div>
		</div>
	</div>
</section>

<!-- including footer -->
<%- include('../../partials/footer.ejs') %>

<!-- linking bookmark script -->
<script src="/scripts/bookmarks.js"></script>

</body>

</html>